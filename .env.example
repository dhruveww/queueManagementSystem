# ---- Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp Business Platform ---------------------------------------
# provider: meta_cloud | gupshup | interakt | mock
WHATSAPP_PROVIDER=mock
# true = real credentials loaded, but messages are logged instead of sent.
# Flip this on first, watch one real service, then set it to false.
WHATSAPP_DRY_RUN=false
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Gupshup / Interakt only
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_SOURCE_NUMBER=

# ---- Razorpay ----------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PLAN_ID_BASIC=
RAZORPAY_PLAN_ID_PRO=

# ---- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# REQUIRED. /api/cron/tick refuses to run without it (fails closed), because
# that endpoint sends paid messages, marks no-shows and purges PII.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Salt for hashing caller IPs used in abuse accounting. Raw IPs are never
# stored; without a salt a bare sha256 of an IPv4 address is brute-forceable.
# Generate with: openssl rand -hex 16
LEAD_IP_SALT=

# ---- Email -------------------------------------------------------------
# provider: mock | gmail | resend. mock logs to the console, including every
# action link, so the whole lead flow is demoable with no credentials.
EMAIL_PROVIDER=mock
EMAIL_DRY_RUN=false
EMAIL_FROM=dhruvi0326@gmail.com
EMAIL_FROM_NAME=Baari
OWNER_EMAIL=dhruvi0326@gmail.com
RESEND_API_KEY=

# ---- Google (Calendar + Gmail share one OAuth client) ------------------
# An API key will NOT work here: free/busy, creating events and sending mail
# all act as a specific user and need OAuth. Run `npm run google:auth`.
# PUBLISH the OAuth consent screen — in "Testing" mode Google expires refresh
# tokens after 7 days and the booking flow dies silently.
MEETING_CALENDAR=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- Meeting policy ----------------------------------------------------
MEETING_TIMEZONE=Asia/Kolkata
MEETING_HOURS=11:00-19:00
MEETING_DAYS=1,2,3,4,5,6
MEETING_LEAD_HOURS=12
MEETING_HORIZON_DAYS=14

# ---- Lead security -----------------------------------------------------
# openssl rand -hex 32 — signs the one-click approve/decline links.
LEAD_ACTION_SECRET=
