# ---- Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp Business Platform ---------------------------------------
# provider: meta_cloud | gupshup | interakt | mock
WHATSAPP_PROVIDER=mock
# true = real credentials loaded, but messages are logged instead of sent.
# Flip this on first, watch one real service, then set it to false.
WHATSAPP_DRY_RUN=false
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Gupshup / Interakt only
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_SOURCE_NUMBER=

# ---- Razorpay ----------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PLAN_ID_BASIC=
RAZORPAY_PLAN_ID_PRO=

# ---- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# REQUIRED. /api/cron/tick refuses to run without it (fails closed), because
# that endpoint sends paid messages, marks no-shows and purges PII.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Salt for hashing caller IPs used in abuse accounting. Raw IPs are never
# stored; without a salt a bare sha256 of an IPv4 address is brute-forceable.
# Generate with: openssl rand -hex 16
LEAD_IP_SALT=
